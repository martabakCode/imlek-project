rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Greetings collection
    match /greetings/{greetingId} {
      // Allow anyone to read greetings
      allow read: if true;
      
      // Allow create with validation
      allow create: if request.resource.data.keys().hasAll(['senderName', 'receiverName', 'template', 'fireIntensity'])
        && request.resource.data.senderName is string
        && request.resource.data.receiverName is string
        && request.resource.data.template is string
        && request.resource.data.fireIntensity is string
        && request.resource.data.template in ['blazing-stallion', 'phoenix-horse', 'emperor-steed', 'celestial-horse', 'golden-lotus', 'dragon-horse']
        && request.resource.data.fireIntensity in ['low', 'medium', 'high']
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 50
        && request.resource.data.receiverName.size() > 0
        && request.resource.data.receiverName.size() <= 50
        && (!request.resource.data.keys().hasAny(['message']) || request.resource.data.message is string)
        && (!request.resource.data.keys().hasAny(['message']) || request.resource.data.message.size() <= 200);
      
      // Allow update only for viewCount and shareCount (analytics)
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['viewCount', 'shareCount']);
      
      // Never allow delete
      allow delete: if false;
    }
  }
}
